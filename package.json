{
  "name": "aws-waf-temp-access",
  "version": "1.0.0",
  "description": "A GitHub Action for temporary AWS WAF access by managing runner IP in IPSets",
  "main": "src/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist && ncc build src/cleanup.js -o dist-cleanup && cp dist-cleanup/index.js dist/cleanup.js && rm -rf dist-cleanup",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js"
  },
  "keywords": [
    "github-action",
    "aws",
    "waf",
    "ipset",
    "security"
  ],
  "author": "digglife",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^9.1.1",
    "@aws-sdk/client-ec2": "^3.1072.0",
    "@aws-sdk/client-wafv2": "^3.1072.0",
    "axios": "^1.18.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.44.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "js-yaml": "^4.2.0",
    "prettier": "^3.8.4"
  }
}
